# Copy this file to .env. The real .env file is ignored by Git.
MYSQL_USER=projectmgmt_app
MYSQL_PASSWORD=change_this_local_password
MYSQL_ROOT_PASSWORD=change_this_local_root_password
MYSQL_PORT=3306
API_PORT=5083
WEB_PORT=4200

# Auth secrets. Generate OTP_HASH_KEY with at least 32 random characters.
OTP_HASH_KEY=replace_with_at_least_32_random_characters
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=replace_with_smtp_username
EMAIL_PASS=replace_with_smtp_app_password
EMAIL_FROM=replace_with_sender_email
