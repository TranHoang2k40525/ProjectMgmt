# Copy to .env and replace every CHANGE_ME value. Never commit .env.
MYSQL_USER=projectmgmt_app
MYSQL_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT_PASSWORD
MYSQL_PORT=3306

# ASP.NET Core maps double underscore to ':'. SslMode=None is for local development only.
ConnectionStrings__ProjectMgmt=Server=127.0.0.1;Port=3306;Database=projectmgmt;User=root;Password=CHANGE_ME;SslMode=None
Database__ServerVersion=8.0.46
