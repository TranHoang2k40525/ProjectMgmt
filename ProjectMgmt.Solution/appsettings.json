{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ProjectMgmt": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Persistence": {
    "EnableSensitiveDataLogging": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
