{
  "ConnectionStrings": {
    "ProjectMgmt": "Server=127.0.0.1;Port=3306;Database=projectmgmt;User=root;Password=YOUR_DATABASE_PASSWORD;SslMode=None;AllowPublicKeyRetrieval=True;"
  },
  "Database": {
    "Provider": "Pomelo.EntityFrameworkCore.MySql",
    "ServerVersion": "8.0.46"
  },
  "Otp": {
    "HashKey": "GENERATE_YOUR_SECURE_RANDOM_KEY_AT_LEAST_32_BYTES_BASE64"
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "Port": 587,
    "User": "your-email@example.com",
    "Pass": "YOUR_SMTP_APP_PASSWORD",
    "From": "your-email@example.com",
    "FromName": "Hệ thống Quản lý Dự án Scrum tích hợp AI",
    "EnableSsl": true,
    "TimeoutMilliseconds": 15000,
    "FallbackToLogOnFailure": false
  },
  "Jwt": {
    "Issuer": "ProjectMgmt.Api",
    "Audience": "ProjectMgmt.Web",
    "SigningKey": "GENERATE_YOUR_SECURE_JWT_SIGNING_KEY_MINIMUM_32_BYTES_BASE64",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:4201",
      "http://localhost:8080",
      "http://projectmgmt_develop.dev.com",
      "https://projectmgmt_develop.dev.com"
    ]
  },
  "Ai": {
    "Provider": "Gemini",
    "DefaultModel": "Gemini 3.8 Flash",
    "MaxTokens": 4096,
    "Temperature": 0.2,
    "TimeoutSeconds": 120,
    "Gemini": {
      "ApiKey": "YOUR_GEMINI_API_KEY",
      "Endpoint": "https://generativelanguage.googleapis.com",
      "ModelName": "Gemini 3.8 Flash",
      "MaxTokens": 4096,
      "Temperature": 0.2
    },
    "Claude": {
      "ApiKey": "YOUR_CLAUDE_API_KEY",
      "Endpoint": "https://api.anthropic.com",
      "ModelName": "claude-3-7-sonnet-20250219",
      "MaxTokens": 4096,
      "Temperature": 0.2
    },
    "OpenAi": {
      "ApiKey": "YOUR_OPENAI_API_KEY",
      "Endpoint": "https://api.openai.com",
      "ModelName": "gpt-4o",
      "OrganizationId": "YOUR_OPENAI_ORG_ID",
      "MaxTokens": 4096,
      "Temperature": 0.2
    },
    "Local": {
      "ApiKey": "",
      "Endpoint": "http://localhost:11434",
      "ModelName": "qwen2.5:32b",
      "MaxTokens": 4096,
      "Temperature": 0.2
    }
  },
  "Redis": {
    "Enabled": false,
    "Host": "YOUR_REDIS_HOST",
    "Port": 6379,
    "Password": "YOUR_REDIS_PASSWORD",
    "Database": 0,
    "InstanceName": "ProjectMgmt:Ai:",
    "TimeoutMs": 3000,
    "ConnectTimeoutMs": 5000,
    "SyncTimeoutMs": 3000,
    "Ssl": false
  },
  "Qdrant": {
    "Enabled": false,
    "Host": "YOUR_QDRANT_HOST",
    "Port": 6334,
    "ApiKey": "YOUR_QDRANT_API_KEY",
    "UseHttps": false,
    "CollectionName": "projectmgmt_specs",
    "TimeoutMs": 5000
  },
  "Langfuse": {
    "Enabled": false,
    "Host": "YOUR_LANGFUSE_HOST",
    "Port": 443,
    "PublicKey": "YOUR_LANGFUSE_PUBLIC_KEY",
    "SecretKey": "YOUR_LANGFUSE_SECRET_KEY",
    "TimeoutMs": 5000,
    "Environment": "development",
    "SampleRate": 1.0
  },
  "Persistence": {
    "EnableSensitiveDataLogging": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}