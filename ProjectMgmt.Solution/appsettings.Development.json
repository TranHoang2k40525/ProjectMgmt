{
  "ConnectionStrings": {
    "ProjectMgmt": "Server=127.0.0.1;Port=3306;Database=projectmgmt;User=root;Password=YOUR_DATABASE_PASSWORD;SslMode=None;AllowPublicKeyRetrieval=True;"
  },
  "Database": {
    "Provider": "Pomelo.EntityFrameworkCore.MySql",
    "ServerVersion": "8.0.46"
  },
  "Otp": {
    "HashKey": "GENERATE_YOUR_SECURE_RANDOM_KEY_AT_LEAST_32_BYTES_BASE64"
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "Port": 587,
    "User": "your-email@example.com",
    "Pass": "YOUR_SMTP_APP_PASSWORD",
    "From": "your-email@example.com",
    "FromName": "Hệ thống Quản lý Dự án Scrum tích hợp AI",
    "EnableSsl": true,
    "TimeoutMilliseconds": 15000,
    "FallbackToLogOnFailure": false
  },
  "Jwt": {
    "Issuer": "ProjectMgmt.Api",
    "Audience": "ProjectMgmt.Web",
    "SigningKey": "GENERATE_YOUR_SECURE_JWT_SIGNING_KEY_MINIMUM_32_BYTES_BASE64",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:4201",
      "http://localhost:8080",
      "http://projectmgmt_develop.dev.com",
      "https://projectmgmt_develop.dev.com"
    ]
  },
  "Persistence": {
    "EnableSensitiveDataLogging": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
