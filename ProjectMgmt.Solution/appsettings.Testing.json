{
  "ConnectionStrings": {
    "ProjectMgmt": "Server=127.0.0.1;Port=3306;Database=ProjectMgmtTests;User Id=test;Password=test;"
  },
  "Database": {
    "Provider": "Pomelo.EntityFrameworkCore.MySql",
    "ServerVersion": "8.0.46"
  },
  "Otp": {
    "HashKey": "test-otp-hash-key-for-unit-and-integration-tests"
  },
  "Email": {
    "SmtpHost": "smtp.test.local",
    "Port": 25,
    "User": "test@test.local",
    "Pass": "testpass",
    "From": "noreply@test.local",
    "FromName": "ProjectMgmt Test",
    "EnableSsl": false,
    "TimeoutMilliseconds": 5000,
    "FallbackToLogOnFailure": true
  },
  "Jwt": {
    "Issuer": "ProjectMgmt.Tests",
    "Audience": "ProjectMgmt.Tests.Client",
    "SigningKey": "unit-test-signing-key-with-more-than-32-bytes",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Persistence": {
    "EnableSensitiveDataLogging": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
